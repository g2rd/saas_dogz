# Supabase (lokalnie: `npx supabase start` wypisuje te wartości)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko po stronie serwera: zadania w tle, webhooki, panel administratora. Nigdy w kodzie klienta.
SUPABASE_SERVICE_ROLE_KEY=

# Publiczny adres aplikacji w linkach z e-maili (wymagany na produkcji; lokalnie domyślnie http://localhost:3000).
# Ten adres musi być też na liście dozwolonych przekierowań w Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tajny pieprz do HMAC sekretów zaproszeń (min. 24 znaki, losowy). Wymagany na produkcji; zmiana unieważnia
# wszystkie oczekujące zaproszenia. Lokalnie ma wartość domyślną.
INVITATION_HASH_SECRET=

# Powiadomienia (etap 4). Wszystko opcjonalne: bez kluczy kanał działa w trybie podglądu.
# Sekret zabezpieczający /api/cron/outbox (Vercel Cron wysyła go w nagłówku Authorization: Bearer). Min. 24 znaki.
CRON_SECRET=
# Klucze VAPID dla web push: `npx web-push generate-vapid-keys`. Klucz publiczny trafia do przeglądarki.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@twoja-domena.pl
# E-mail: na produkcji Resend; lokalnie wiadomości trafiają do Mailpit (http://127.0.0.1:54324).
RESEND_API_KEY=
EMAIL_FROM=DogTrainer <powiadomienia@twoja-domena.pl>

# Języki widoczne dla użytkowników (lista oddzielona przecinkami). Bez zmiennej działa tylko polski; angielski włączasz tu, gdy katalog
# messages/en jest kompletny (od etapu 5 jest), a w razie potrzeby wyłączysz go ustawiając samo `pl` (docs/WDROZENIE-WIELOJEZYCZNOSCI.md). Przy dwóch i więcej językach w `Więcej` pojawia się wybór języka,
# a domyślnie język bierzemy z telefonu lub przeglądarki.
ENABLED_LOCALES=pl,en

# Panel właściciela platformy (/admin). Weryfikacja dwuetapowa (TOTP): na produkcji domyślnie wymagana,
# lokalnie wyłączona (ustaw 1, gdy w Supabase jest włączone MFA: sekcja [auth.mfa.totp] w config.toml).
ADMIN_REQUIRE_MFA=
# Dane operatora w regulaminie i polityce prywatności (/terms, /privacy); bez nich strony pokażą „do uzupełnienia”
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
# Adres obsługi: pokazywany zawieszonym trenerom, w pasku „tylko do odczytu” i jako kontakt w regulaminie.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Monitoring: błędy serwera do Sentry (https://sentry.io, region UE). Bez SENTRY_DSN nic nie jest wysyłane.
# Format: https://<klucz-publiczny>@<host>/<numer-projektu>
SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=

# Sterowanie demo w panelu właściciela (/admin/demo): powiadomienie testowe, przetwarzanie od razu, symulacja kolejnych dni.
# Włączaj tylko lokalnie lub na środowisku demo; na serwerze z prawdziwymi klientami zostaw puste (symulacja czasu wysyła prawdziwe wiadomości).
DEMO_CONTROLS=
